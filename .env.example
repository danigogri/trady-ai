# ── Environment ───────────────────────────────────────────────────────────────
TRADY_AI_ENVIRONMENT=development
TRADY_AI_DRY_RUN=true
TRADY_AI_LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────────────────
TRADY_AI_DB_PATH=data/trady_ai.db

# ── Security (Phase 6+ — not required for dry_run) ────────────────────────────
TRADY_AI_SECRETS_API_KEY=

# ── Polymarket Connection ─────────────────────────────────────────────────────
# REST and WebSocket endpoints for the Polymarket CLOB API.
# Defaults work for dry_run; customize only if using a different environment.
TRADY_AI_POLYMARKET_REST_URL=https://clob.polymarket.com
TRADY_AI_POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# ── Polymarket Credentials (NOT required for dry_run) ─────────────────────────
# Only needed when execution_mode=live (Phase 6+).
# Dry-run uses public endpoints without authentication.
TRADY_AI_POLYMARKET_API_KEY=
TRADY_AI_POLYMARKET_SECRET=
TRADY_AI_POLYMARKET_PASSPHRASE=

# ── Market Configuration ──────────────────────────────────────────────────────
# REQUIRED for Paper Trading. Comma-separated Polymarket Condition IDs.
# Without this, capture produces zero events.
# Example: TRADY_AI_ACTIVE_MARKETS=0xabc123...,0xdef456...
TRADY_AI_ACTIVE_MARKETS=

# ── Discovery Rules (BL-029, externalized for operator review per AD-5) ────────
# Comma-separated league slugs to search, in priority order. First league with an
# eligible market wins (no ranking, no AI — deterministic per OC-2 / AD-4).
# Per https://gamma-api.polymarket.com/sports there are 30+ leagues with football
# markets. Defaults: mex, mls, epl, arg, bra, ucl, uel, copa.
# Example: TRADY_AI_FOOTBALL_LEAGUES=mex,mls,epl
# TRADY_AI_FOOTBALL_LEAGUES=

# Regex pattern that eligible "winner" market questions must match. Default matches
# "Will <team> win on YYYY-MM-DD?". Override carefully — too broad a pattern can
# select non-winner markets (draws, O/U, etc.).
# Default: ^Will .+ win on \d{4}-\d{2}-\d{2}\??$
# TRADY_AI_WINNER_PATTERN=

# Comma-separated substrings; if any appears in a market question, it's rejected.
# Case-insensitive substring match. Defaults: "end in a draw", "O/U", "over/under",
# "both teams to score", "handicap", "spread".
# Example: TRADY_AI_REJECT_PATTERNS=end in a draw,O/U
# TRADY_AI_REJECT_PATTERNS=
